[run]
branch = true
omit =
    */evo_engine/ui/app.py
    */evo_engine/cinematic/_manim.py
    */evo_engine/cinematic/_b3_manim.py
    */evo_engine/desktop/*

# Streamlit AppTest executes the dashboard entrypoint in Streamlit's isolated app
# runner, which is verified by tests/ui/test_app.py but is not attributed to the
# source file by pytest-cov. Keep presentation transforms/models in coverage and
# omit only the framework-owned entrypoint from the aggregate threshold.
#
# The Manim renderers are optional heavy dependencies that are intentionally absent
# from the protected default quality environment. Deterministic cinematic timeline
# and B3-director preparation plus the lazy public APIs remain in aggregate coverage;
# the renderer modules themselves are verified by the dedicated headless cinematic
# smoke workflow.
#
# PySide6 is likewise an optional frontend dependency and is intentionally absent
# from the protected default quality environment. The native desktop package is
# validated by the dedicated Desktop workflow, including controller/model tests,
# source launch, standalone deployment, and packaged launch smoke. Keep the shared
# presentation and Workbench layers in the aggregate core coverage threshold.
