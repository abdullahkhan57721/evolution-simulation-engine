#!/usr/bin/env bash
# Apply Ruff's safe autofixes and canonical formatting to active Python code.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT" || exit 1

if [[ -x "$REPO_ROOT/venv/bin/ruff" ]]; then
    RUFF="$REPO_ROOT/venv/bin/ruff"
elif [[ -x "$REPO_ROOT/.venv/bin/ruff" ]]; then
    RUFF="$REPO_ROOT/.venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
    RUFF="$(command -v ruff)"
else
    echo "Error: Ruff is not installed."
    exit 127
fi

if [[ $# -eq 0 ]]; then
    set -- src tests examples
fi

printf '%s\n' "======================================================================"
printf '%s\n' "RUFF — SAFE FIXES"
printf '%s\n' "======================================================================"
"$RUFF" check --fix "$@"

printf '\n%s\n' "======================================================================"
printf '%s\n' "RUFF — FORMAT"
printf '%s\n' "======================================================================"
"$RUFF" format "$@"
