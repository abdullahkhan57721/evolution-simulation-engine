#!/usr/bin/env bash
# Report and enforce cognitive complexity with Complexipy.
#
# Usage:
#   ./scripts/complexity
#   ./scripts/complexity src/evo_engine/processes
#
# Environment:
#   COMPLEXIPY_TOP_N=20 ./scripts/complexity
#   COMPLEXIPY_MAX=12 ./scripts/complexity

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT" || exit 1

TARGET="${1:-src/evo_engine}"
TOP_N="${COMPLEXIPY_TOP_N:-20}"
MAX_COMPLEXITY="${COMPLEXIPY_MAX:-15}"

if [[ -x "$REPO_ROOT/venv/bin/complexipy" ]]; then
    COMPLEXIPY="$REPO_ROOT/venv/bin/complexipy"
elif [[ -x "$REPO_ROOT/.venv/bin/complexipy" ]]; then
    COMPLEXIPY="$REPO_ROOT/.venv/bin/complexipy"
elif command -v complexipy >/dev/null 2>&1; then
    COMPLEXIPY="$(command -v complexipy)"
else
    echo "Error: Complexipy is not installed."
    echo 'Install development dependencies with:'
    echo '  python -m pip install -e ".[dev]"'
    exit 127
fi

if [[ ! -e "$TARGET" ]]; then
    echo "Error: target does not exist: $TARGET"
    exit 2
fi

separator() {
    printf '\n%s\n' "======================================================================"
}

heading() {
    separator
    printf '%s\n' "$1"
    printf '%s\n' "======================================================================"
}

heading "COMPLEXIPY — TOP ${TOP_N} FUNCTIONS"
"$COMPLEXIPY" "$TARGET" \
    --top "$TOP_N" \
    --sort desc \
    --ignore-complexity
report_status=$?

heading "COMPLEXIPY — THRESHOLD VIOLATIONS + REFACTOR SUGGESTIONS"
"$COMPLEXIPY" "$TARGET" \
    --max-complexity-allowed "$MAX_COMPLEXITY" \
    --failed \
    --suggest-refactors \
    --ignore-complexity
suggestion_status=$?

heading "COMPLEXIPY — COMPLEXITY GATE (MAX ${MAX_COMPLEXITY})"
"$COMPLEXIPY" "$TARGET" \
    --max-complexity-allowed "$MAX_COMPLEXITY" \
    --failed \
    --quiet
threshold_status=$?

heading "COMPLEXIPY — SUMMARY"
echo "Target:      $TARGET"
echo "Top count:   $TOP_N"
echo "Max allowed: $MAX_COMPLEXITY"
echo "Version:     $($COMPLEXIPY --version 2>/dev/null || echo unknown)"

if [[ $report_status -ne 0 || $suggestion_status -ne 0 ]]; then
    echo "Reporting:   ERROR"
    exit 2
fi

echo "Reporting:   PASS"

if [[ $threshold_status -eq 0 ]]; then
    echo "Threshold:   PASS"
    exit 0
fi

echo "Threshold:   FAIL"
exit 1
