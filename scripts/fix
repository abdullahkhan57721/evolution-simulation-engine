#!/usr/bin/env bash
# Apply Ruff's safe autofixes and canonical formatting to repository Python code.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT" || exit 1

if [[ -x "$REPO_ROOT/venv/bin/ruff" ]]; then
    RUFF="$REPO_ROOT/venv/bin/ruff"
elif [[ -x "$REPO_ROOT/.venv/bin/ruff" ]]; then
    RUFF="$REPO_ROOT/.venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
    RUFF="$(command -v ruff)"
else
    echo "Error: Ruff is not installed."
    exit 127
fi

# Match ./scripts/lint's default repository scope so anything CI verifies can be
# mechanically cleaned before a checkpoint or push. Ruff still respects its
# normal excludes and .gitignore rules.
if [[ $# -eq 0 ]]; then
    set -- .
fi

printf '%s\n' "======================================================================"
printf '%s\n' "RUFF — SAFE FIXES"
printf '%s\n' "======================================================================"
"$RUFF" check --fix "$@"
fix_status=$?

printf '\n%s\n' "======================================================================"
printf '%s\n' "RUFF — FORMAT"
printf '%s\n' "======================================================================"
"$RUFF" format "$@"
format_status=$?

printf '\n%s\n' "======================================================================"
printf '%s\n' "RUFF — FIX SUMMARY"
printf '%s\n' "======================================================================"
echo "Safe fixes: $([[ $fix_status -eq 0 ]] && echo PASS || echo 'INCOMPLETE / ERRORS REMAIN')"
echo "Format:     $([[ $format_status -eq 0 ]] && echo PASS || echo FAIL)"

# Formatting should still run when lint leaves a non-fixable diagnostic, but the
# command must not hide that failure behind a successful final formatter exit.
if [[ $fix_status -ne 0 || $format_status -ne 0 ]]; then
    exit 1
fi
