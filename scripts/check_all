#!/usr/bin/env bash
# Run ./scripts/check_all --help to see common wrapper and raw tool commands.
# Run the repository's routine local quality suite.
#
# Runs every selected routine check even after failures and summarizes results at
# the end. By default, pauses after each check so output can be reviewed before
# continuing. GitHub Actions additionally runs performance/profile regression
# checks and uploads their artifacts.
#
# Full routine checks:
#   1. Ruff lint + formatting verification
#   2. Pyright static type checking
#   3. Import Linter architecture contracts
#   4. Focused simulation-kernel semantic contracts
#   5. Complexipy cognitive complexity + threshold gate
#   6. pytest with line + branch coverage
#   7. MkDocs strict documentation build
#
# Fast checkpoint checks (--fast):
#   1. Ruff lint + formatting verification
#   2. Pyright static type checking
#   3. Import Linter architecture contracts
#   4. Focused simulation-kernel semantic contracts
#   5. Complexipy cognitive complexity + threshold gate
#
# Usage:
#   ./scripts/check_all
#   ./scripts/check_all --no-pause
#   ./scripts/check_all --fast --no-pause
#   COVERAGE_FAIL_UNDER=90 ./scripts/check_all

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT" || exit 1

show_help() {
    cat <<'EOF'
Usage:
  ./scripts/check_all
  ./scripts/check_all --no-pause
  ./scripts/check_all --fast
  ./scripts/check_all --fast --no-pause
  COVERAGE_FAIL_UNDER=90 ./scripts/check_all

Default behavior:
  Runs all seven routine local checks.
  After each check finishes, pauses so you can review the output.
  Press Enter when you are ready to continue to the next check.

Options:
  --fast        Run the five inexpensive checkpoint checks only: Ruff, Pyright,
                Import Linter, kernel contracts, and Complexipy. This mode is
                non-mutating; run ./scripts/fix first when you want safe cleanup.
  --no-pause    Run selected checks continuously without interactive pauses.
  -h, --help    Show this help.

Full routine quality gates run by check_all:
  ./scripts/lint
  ./scripts/typecheck
  ./scripts/architecture
  ./scripts/kernel_contracts
  ./scripts/complexity
  ./scripts/coverage
  ./scripts/docs

Fast checkpoint mode intentionally omits the expensive full coverage suite and
strict documentation build. GitHub Actions additionally runs the repository's
performance/profile regression checks on final/non-draft candidate heads.

Useful individual commands:
  ./scripts/fix
  ./scripts/lint --help
  ./scripts/typecheck --help
  ./scripts/test --help
  ./scripts/coverage --help
  ./scripts/architecture --help
  ./scripts/kernel_contracts
  ./scripts/complexity --help
  ./scripts/docs --help

Typical development workflow:
  ./scripts/fix
  <focused milestone tests>
  ./scripts/check_all --fast --no-pause

Before review-ready / final verification:
  ./scripts/fix
  ./scripts/check_all --no-pause

For CI/non-interactive use:
  ./scripts/check_all --no-pause
EOF
}

pause_between_checks=1
fast_mode=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        --no-pause)
            pause_between_checks=0
            ;;
        --fast)
            fast_mode=1
            ;;
        *)
            echo "Error: unknown argument: $1" >&2
            echo "Run ./scripts/check_all --help for usage." >&2
            exit 2
            ;;
    esac
    shift
done

separator() {
    printf '\n%s\n' "========================================================================"
}

pause_for_review() {
    next_label="$1"

    if [[ $pause_between_checks -eq 0 ]]; then
        return
    fi

    printf '\n%s\n' "------------------------------------------------------------------------"
    printf 'Review the output above. Press Enter when you are ready for %s...' "$next_label"
    IFS= read -r _
}

run_check() {
    check_name="$1"
    check_script="$2"
    result_var="$3"

    separator
    printf '%s\n' "$check_name"
    printf '%s\n' "========================================================================"

    "$check_script"
    status=$?

    if [[ $status -eq 0 ]]; then
        printf -v "$result_var" '%s' "PASS"
    elif [[ $status -eq 3 ]]; then
        printf -v "$result_var" '%s' "SKIP"
        skips=$((skips + 1))
    else
        printf -v "$result_var" '%s' "FAIL ($status)"
        failures=$((failures + 1))
    fi
}

failures=0
skips=0
ruff_result=""
pyright_result=""
architecture_result=""
kernel_contracts_result=""
complexity_result=""
coverage_result="NOT RUN (fast mode)"
docs_result="NOT RUN (fast mode)"

total_checks=7
if [[ $fast_mode -eq 1 ]]; then
    total_checks=5
fi

run_check "1/$total_checks — RUFF" "$SCRIPT_DIR/lint" ruff_result
pause_for_review "2/$total_checks — PYRIGHT"

run_check "2/$total_checks — PYRIGHT" "$SCRIPT_DIR/typecheck" pyright_result
pause_for_review "3/$total_checks — IMPORT LINTER"

run_check "3/$total_checks — IMPORT LINTER" "$SCRIPT_DIR/architecture" architecture_result
pause_for_review "4/$total_checks — KERNEL CONTRACTS"

run_check "4/$total_checks — KERNEL CONTRACTS" "$SCRIPT_DIR/kernel_contracts" kernel_contracts_result
pause_for_review "5/$total_checks — COMPLEXIPY"

run_check "5/$total_checks — COMPLEXIPY" "$SCRIPT_DIR/complexity" complexity_result

if [[ $fast_mode -eq 0 ]]; then
    pause_for_review "6/$total_checks — PYTEST + COVERAGE"
    run_check "6/$total_checks — PYTEST + COVERAGE" "$SCRIPT_DIR/coverage" coverage_result
    pause_for_review "7/$total_checks — MKDOCS"
    run_check "7/$total_checks — MKDOCS" "$SCRIPT_DIR/docs" docs_result
fi

pause_for_review "the final summary"

separator
printf '%s\n' "CHECK_ALL — FINAL SUMMARY"
printf '%s\n' "========================================================================"
printf '%-20s %s\n' "Ruff" "$ruff_result"
printf '%-20s %s\n' "Pyright" "$pyright_result"
printf '%-20s %s\n' "Import Linter" "$architecture_result"
printf '%-20s %s\n' "Kernel Contracts" "$kernel_contracts_result"
printf '%-20s %s\n' "Complexipy" "$complexity_result"
printf '%-20s %s\n' "pytest + coverage" "$coverage_result"
printf '%-20s %s\n' "MkDocs" "$docs_result"
printf '%s\n' "------------------------------------------------------------------------"

if [[ $failures -eq 0 ]]; then
    if [[ $fast_mode -eq 1 ]]; then
        if [[ $skips -gt 0 ]]; then
            echo "ALL FAST CHECKS PASSED ($skips SKIPPED)"
        else
            echo "ALL FAST CHECKS PASSED"
        fi
    elif [[ $skips -gt 0 ]]; then
        echo "ALL CONFIGURED CHECKS PASSED ($skips SKIPPED)"
    else
        echo "ALL CHECKS PASSED"
    fi
    exit 0
fi

echo "$failures CHECK(S) FAILED; $skips SKIPPED"
exit 1
