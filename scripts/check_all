#!/usr/bin/env bash
# Run ./scripts/check_all --help to see common wrapper and raw tool commands.
# Run the repository's local quality suite.
#
# Full mode runs every routine check even after failures and summarizes results.
# Fast mode is the development checkpoint gate: Ruff, Pyright, Import Linter,
# kernel contracts, and Complexipy only. GitHub Actions additionally runs
# performance/profile regression checks for final/non-draft validation.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT" || exit 1

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
Usage:
  ./scripts/check_all
  ./scripts/check_all --no-pause
  ./scripts/check_all --fast
  ./scripts/check_all --fast --no-pause
  COVERAGE_FAIL_UNDER=90 ./scripts/check_all --no-pause

Modes:
  Full (default):
    1. Ruff lint + formatting verification
    2. Pyright static type checking
    3. Import Linter architecture contracts
    4. Focused simulation-kernel semantic contracts
    5. Complexipy cognitive complexity + threshold gate
    6. pytest with line + branch coverage
    7. MkDocs strict documentation build

  --fast:
    Runs checks 1-5 only. Use this after focused tests and before ordinary
    development pushes/checkpoints. It intentionally skips full coverage and docs.

Options:
  --fast        Run the fast development checkpoint gate.
  --no-pause    Run continuously without interactive pauses.
  -h, --help    Show this help.

Typical development workflow:
  ./scripts/fix
  ./scripts/test <focused test paths>
  ./scripts/check_all --fast --no-pause

Final candidate workflow:
  ./scripts/fix
  ./scripts/check_all --no-pause

GitHub Actions additionally runs performance/profile regression checks for final
non-draft PR validation and main verification.
EOF
    exit 0
fi

pause_between_checks=1
fast_mode=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --fast)
            fast_mode=1
            ;;
        --no-pause)
            pause_between_checks=0
            ;;
        *)
            echo "Error: unknown argument: $1" >&2
            echo "Run ./scripts/check_all --help for usage." >&2
            exit 2
            ;;
    esac
    shift
done

separator() {
    printf '\n%s\n' "========================================================================"
}

pause_for_review() {
    next_label="$1"

    if [[ $pause_between_checks -eq 0 ]]; then
        return
    fi

    printf '\n%s\n' "------------------------------------------------------------------------"
    printf 'Review the output above. Press Enter when you are ready for %s...' "$next_label"
    IFS= read -r _
}

run_check() {
    check_name="$1"
    check_script="$2"
    result_var="$3"

    separator
    printf '%s\n' "$check_name"
    printf '%s\n' "========================================================================"

    "$check_script"
    status=$?

    if [[ $status -eq 0 ]]; then
        printf -v "$result_var" '%s' "PASS"
    elif [[ $status -eq 3 ]]; then
        printf -v "$result_var" '%s' "SKIP"
        skips=$((skips + 1))
    else
        printf -v "$result_var" '%s' "FAIL ($status)"
        failures=$((failures + 1))
    fi
}

failures=0
skips=0
ruff_result=""
pyright_result=""
architecture_result=""
kernel_contracts_result=""
complexity_result=""
coverage_result="SKIPPED (fast mode)"
docs_result="SKIPPED (fast mode)"

run_check "1/5 — RUFF" "$SCRIPT_DIR/lint" ruff_result
pause_for_review "2/5 — PYRIGHT"

run_check "2/5 — PYRIGHT" "$SCRIPT_DIR/typecheck" pyright_result
pause_for_review "3/5 — IMPORT LINTER"

run_check "3/5 — IMPORT LINTER" "$SCRIPT_DIR/architecture" architecture_result
pause_for_review "4/5 — KERNEL CONTRACTS"

run_check "4/5 — KERNEL CONTRACTS" "$SCRIPT_DIR/kernel_contracts" kernel_contracts_result
pause_for_review "5/5 — COMPLEXIPY"

run_check "5/5 — COMPLEXIPY" "$SCRIPT_DIR/complexity" complexity_result

if [[ $fast_mode -eq 0 ]]; then
    pause_for_review "6/7 — PYTEST + COVERAGE"
    run_check "6/7 — PYTEST + COVERAGE" "$SCRIPT_DIR/coverage" coverage_result
    pause_for_review "7/7 — MKDOCS"
    run_check "7/7 — MKDOCS" "$SCRIPT_DIR/docs" docs_result
fi

pause_for_review "the final summary"

separator
if [[ $fast_mode -eq 1 ]]; then
    printf '%s\n' "CHECK_ALL — FAST CHECKPOINT SUMMARY"
else
    printf '%s\n' "CHECK_ALL — FULL SUMMARY"
fi
printf '%s\n' "========================================================================"
printf '%-20s %s\n' "Ruff" "$ruff_result"
printf '%-20s %s\n' "Pyright" "$pyright_result"
printf '%-20s %s\n' "Import Linter" "$architecture_result"
printf '%-20s %s\n' "Kernel Contracts" "$kernel_contracts_result"
printf '%-20s %s\n' "Complexipy" "$complexity_result"
printf '%-20s %s\n' "pytest + coverage" "$coverage_result"
printf '%-20s %s\n' "MkDocs" "$docs_result"
printf '%s\n' "------------------------------------------------------------------------"

if [[ $failures -eq 0 ]]; then
    if [[ $skips -gt 0 ]]; then
        echo "ALL CONFIGURED CHECKS PASSED ($skips SKIPPED)"
    elif [[ $fast_mode -eq 1 ]]; then
        echo "FAST CHECKPOINT PASSED"
    else
        echo "ALL CHECKS PASSED"
    fi
    exit 0
fi

echo "$failures CHECK(S) FAILED; $skips SKIPPED"
exit 1
